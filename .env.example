# Copy to .env and edit. Never commit .env.
# This tool is meant to run ON the machine that has the GPU (it reads the GPU via NVML / nvidia-smi and the CPU directly).

# --- llama-swap (or any OpenAI-compatible /v1 endpoint) ---
LLAMA_SWAP_URL=http://localhost:8080     # This is where you put your server address EXCLUDING the /v1 endpoint
# LLAMA_SWAP_API_KEY=                    # api key if required, eg unsloth interface requires this, lama-swap and llama.cpp do not

# --- Optional fallback: a single Strata endpoint, used only if llama-swap is not reachable ---
# STRATA_URL=http://localhost:8080
# STRATA_API_KEY=
# STRATA_MODEL=qwen3.8-Next-Flash # model name sent in requests (default: first id from /v1/models, else "strata")
# STRATA_PARAMS_B=125             # facts about the model, for ranking/radar (it has no filename to parse)
# STRATA_ACTIVE_B=3.8             # active params if MoE, else leave unset
# STRATA_QUANT=IQ3_S              # optional: otherwise parsed from Strata's own model id
# STRATA_CTX=32768                # optional: otherwise read from Strata's API (see --probe-strata)

# --- GPU ---
# Fallback VRAM total (GB) if nvidia-smi doesn't report it
VRAM_LIMIT_GB=16
# Benchmark one GPU only (nvidia-smi index). Empty = aggregate all GPUs.
# GPU_INDEX=0
GPU_POLL_MS=200
# GPU telemetry backend: auto = NVML (pip install nvidia-ml-py) and fall back to a persistent `nvidia-smi` stream
# if the bindings are missing | nvml = NVML only | smi = nvidia-smi only (the pre-v2 behaviour)
GPU_BACKEND=auto
# true = measure GPU energy per request from NVML's hardware energy counter (exact, independent of GPU_POLL_MS;
# Volta or newer). false = mean sampled power x request time, as in earlier versions, so old results stay comparable.
GPU_ENERGY_COUNTER=false

# --- System RAM / spill detection ---
# Name (regex) of the inference-server executable, to measure how much RAM it holds. Run --check to see matches.
RAM_PROCESS_PATTERN=llama-server
RAM_POLL_MS=500
RAM_SPILL_THRESHOLD_GB=2     # only used when launch flags can't be read (e.g. Strata)
# RAM_OVERHEAD_GB=2          # typical server RAM of a fully-GPU model; default: measured from this run
# GOLDILOCKS_VRAM_ONLY=false # true = exclude models that spill into RAM from the podium

# --- CPU power ---
# Read from RAPL energy counters (Intel, and AMD on Linux >= 5.8). Usually needs root.
RAPL_PATH=/sys/class/powercap
# Fallback if RAPL isn't readable: a Home Assistant power sensor (polled, so it lags short requests)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=            # long-lived token; keep it in .env only
# HA_CPU_POWER_ENTITY=sensor.my_server_cpu_power
HA_POLL_INTERVAL=1

# --- Benchmark behaviour ---
RUNS_PER_PROMPT=3            # median is reported
TIMEOUT_TECH=60
TIMEOUT_LOGIC=300
TIMEOUT_LOAD=300
MAX_TOKENS_TECH=300
MAX_TOKENS_LOGIC=500
TEMPERATURE=0.2
RETRIES=2
SETTLE_SECONDS=5             # wait after unloading, then sample idle baseline
COOLDOWN_SECONDS=5           # pause between models
PREFILL_WORDS=1200           # long-prompt prefill test (~1.5k tokens). 0 disables
CACHE_TEST=true              # cold vs warm prompt-cache test (needs PREFILL_WORDS > 0)
# MODEL_FILTER=Qwen|gemma    # regex; only benchmark matching model ids

# --- Test at the deployed context (v2.2) ---
# The 1.2k-word prefill test above flatters offloaded MoEs: prompt speed drops as the prompt grows. These run one cold,
# unique prompt per length (lengths longer than the model's loaded context are skipped). Allowed: 8k 16k 32k 64k 128k.
PREFILL_CTX_TESTS=8192,32768,65536
# Time to first token for an agent-sized request (system prompt with a tool catalogue + history), cold and next turn.
AGENT_PROMPT_TOKENS=20000    # 0 = off
# Minimum context the model must be LOADED with (llama-swap -c). Default: the budget profile's MIN_CTX (below).
# MIN_CTX=65536
MIN_CTX_ACTION=flag          # flag = run it, mark Ctx with a warning, keep it off the podium | refuse = skip the model

# --- What the server actually loaded (v2.2) ---
# KV type (-ctk/-ctv), -fa, -ub/-b, --parallel, mmproj and offload are read from the llama-server command line.
# The GGUF header gives size, bits per weight, architecture (MoE / experts / MLA / sliding window / hybrid SSM),
# total + active params, and the KV cache cost per token -> "Max ctx" column.
GGUF_INSPECT=true
# llama-swap in Docker: the model path the server sees (/models/x.gguf) is read through /proc/<pid>/root when run as
# root. Otherwise map container paths to host paths, or list folders to find the file by name:
# GGUF_PATH_MAP=/models=/mnt/AI-Models
# GGUF_SEARCH_DIRS=/mnt/AI-Models
MAX_CTX_VRAM_PCT=85          # "Max ctx @85%" = context that would fit with VRAM at this % of the GPU
# TECH_PROMPT=Explain quantum computing in 3 sentences.
# LOGIC_PROMPT=Outline a 101 Physics Handbook. Create a 3-question quiz.

# --- Ranking ---
GOLDILOCKS_MODE=linear       # linear = params_B x TPS, log = ln(params_B) x TPS
GOLDILOCKS_MAX_VRAM_PCT=100  # models above this % of VRAM are excluded from the podium

# --- Agent score (0-100): quality first, speed second ---
# Quality credit = eval avg vs the best of the run (within AGENT_ACC_TOL points of the best = a tie at 100, then it falls
# steeply), then x (1 - AGENT_FALLBACK_PENALTY% x share of questions retried). Without evals: a proxy from dense-equivalent
# size and bits per weight (no VRAM in it any more). A model whose evals all failed gets NO Agent score.
# Speed (prefill / agent TTFT 40%, s/q 35%, generation TPS 25%) can only remove up to AGENT_SPEED_WEIGHT of the credit.
# AGENT_SEC_REF=60           # s/q at which the time part of the speed factor halves. Higher = time matters less.
# AGENT_ACC_TOL=             # points below the best that still count as a tie. Empty = 1 standard error (~3 pts at 72-129 questions).
# AGENT_ACC_SPAN=40          # points under the tie zone at which the accuracy credit reaches 0.
# AGENT_SPEED_WEIGHT=0.3     # 0 = accuracy only, 1 = speed can erase the whole credit. (was 0.4)
# AGENT_TPS_REF=200          # tokens/s that earns the full token-speed credit.
# AGENT_PREFILL_REF=4000     # prefill tok/s (longest PREFILL_CTX_TESTS length) that earns the full prefill credit
# AGENT_TTFT_REF=15          # agent-prompt TTFT (s) at which the prefill credit halves (used when AGENT_PROMPT_TOKENS > 0)
# AGENT_FALLBACK_PENALTY=10  # % of the quality credit lost if EVERY question needed the No-Thinking retry
# AGENT_LONGCTX_WEIGHT=0.25  # share of quality from long-context retrieval (only when every model has a result)

# --- VRAM sweet spot (Agent score x VRAM fit) ---
# VRAM use inside LOW-HIGH % of the GPU is ideal (fit 100%); above HIGH it falls, to 50% at MAX, to 0 at 100%.
# VRAM_SWEET_LOW=80
# VRAM_SWEET_HIGH=90
# VRAM_SWEET_MAX=94
# VRAM_UNDERUSE_FLOOR=0.85   # fit of a model using almost no VRAM (was 0.5). Once a model fits, quality should decide.

# --- Per-machine budget profile: one pass/fail column per rule on the dashboard ---
# server | main | any name of your own | none. Built-in defaults:
#   server: MIN_CTX=65536, VRAM_RESERVE_GB=2.0 (Immich face/CLIP models), KV_MIN=q8_0, MAX_RETRY_PCT=25
#   main:   MIN_CTX=65536, VRAM_RESERVE_GB=1.5 (desktop baseline),        MAX_RETRY_PCT=25
# Override or add any rule with BUDGET_<PROFILE>_<RULE> (empty / off = not checked). Rules: MIN_CTX, VRAM_RESERVE_GB,
# MAX_VRAM_PCT, KV_MIN, MAX_SPILL_GB, MIN_TPS, MIN_PREFILL_TPS, MAX_AGENT_TTFT_S, MIN_EVAL_PCT, MAX_RETRY_PCT,
# MIN_LONGCTX_PCT. VRAM rule: model VRAM (increase over idle) + reserve <= GPU total x MAX_VRAM_PCT.
BUDGET_PROFILE=server
# BUDGET_SERVER_VRAM_RESERVE_GB=2.0
# BUDGET_SERVER_MIN_TPS=40
# BUDGET_MAIN_VRAM_RESERVE_GB=1.5
BUDGET_PODIUM_PASS_ONLY=true # models that fail a rule stay in the table but off the podium

# --- Electricity cost (optional; adds $/1M tokens and $/1k queries columns) ---
# Price per kWh in your currency. Set OFFPEAK too to get a Peak / Off-peak toggle on the dashboard.
# ELECTRICITY_RATE_PEAK=0.60
# ELECTRICITY_RATE_OFFPEAK=0.35
CURRENCY_SYMBOL=$

# --- Dashboard header: host hardware (auto-detected; set any of these to override) ---
# HW_CPU=Intel Core
# HW_RAM=32 GB DDR4
# HW_GPU=RTX 5060 Ti 16 GB

# --- Output ---
# Leave unset to write to a "results" folder next to benchmark.py (regardless of where you run it from).
# A relative value is also resolved against the script's folder, not the current directory.
# OUTPUT_DIR=results
WRITE_MARKDOWN=false    #true if you want one created, false if you dont
JSON=true               # true = write results/benchmark_<date>_<time>.json and results/results.json (structured: metadata, telemetry, evals)
LOG=true                # true = also save everything printed to results/benchmark_<date>_<time>.log (with start/end/time taken)
CSV=true                # true = write results/benchmark_<date>_<time>.csv and append to the history CSV; false = no CSV files
# The newest dashboard is always written next to benchmark.py as benchmark_dashboard.html; a timestamped copy goes in the results folder.

# ============================================================================
# Model selection
# ============================================================================
# `python benchmark.py --list-models` prints what the server offers ([x] = will run) and exits.
# INCLUDE_MODELS: "all" or a comma-separated list of exact model ids (case-insensitive; * and ? wildcards work).
# EXCLUDE_MODELS: comma-separated ids to skip. MODEL_FILTER (regex, above) still works and is applied as well.
INCLUDE_MODELS=all
# INCLUDE_MODELS=model-a,model-b
EXCLUDE_MODELS=

# ============================================================================
# Evaluations (accuracy / pass-rate tests, run AFTER the speed tests)
# ============================================================================
RUN_EVAL_TESTS=true         # master toggle  (true/false)
# Only datasets set to true are loaded and run:
EVAL_GPQA=false              # GPQA Diamond (198 q, 4-choice)              -> accuracy  (skip for routine runs)
EVAL_MMLU_PRO=true           # MMLU-Pro (12,032 q, up to 10 choices)       -> accuracy
EVAL_HUMANEVAL=true          # HumanEval (164 problems)                    -> pass@1
EVAL_MBPP=true               # MBPP (500 test problems)                    -> pass@1
EVAL_LIVECODEBENCH=false     # LiveCodeBench (1,055 problems, ~4 GB download) -> pass@1  (skip for most runs)
EVAL_GSM8K=false             # GSM8K (1,319 grade-school math word problems)  -> accuracy (final number)
EVAL_MATH=false              # MATH-500 (500 competition problems, LaTeX answers) -> accuracy
EVAL_TOOLCALL=false          # Tool calling (32 built-in BFCL-style cases, no download) -> accuracy. For the Hermes role.
# EVAL_TOOLCALL_STRICT=true  # only native tool_calls count; a call written as text fails (usually: no --jinja)
# --- Long-context retrieval (multi-key needle test) ---
# Hides LONGCTX_KEYS vault codes (+ as many decoys) in a long text and asks for them. Lengths above the model's loaded
# context are skipped. The benchmark cannot change the server's KV type (-ctk/-ctv in llama-swap's config): it reads it,
# and flags (or skips) results with KV below LONGCTX_KV_MIN. Lower it (e.g. q4_0) to accept such runs.
EVAL_LONGCTX=true
LONGCTX_LENGTHS=65536,131072 # allowed: 32k 64k 128k
LONGCTX_KV_MIN=q8_0          # f16 > q8_0 > q5_1 > q5_0 > q4_1 > q4_0
LONGCTX_KV_ACTION=flag       # flag | skip
# LONGCTX_TRIALS=2           # prompts per length
# LONGCTX_KEYS=4             # needles asked for per prompt
# LONGCTX_NO_THINK=true      # ask with thinking off (a retrieval test, not a reasoning test)

# EVAL_PROFILE = rows per dataset (approx. margin of error, 95% confidence):
#   test = 6 (+/-40%) | quick = 11 (+/-30%) | basic = 24 (+/-20%) | moderate = 43 (+/-15%) | standard = 96 (+/-10%)
#   thorough = 196 (+/-7%) | deep = 384 (+/-5%) | ultra = 9604 (+/-1%) | full = every row
# Rows are sampled with EVAL_SEED, so every model
# gets the same questions. (Datasets smaller than the profile are used in full.)
# The dashboard shows the margin next to the profile; test / quick are flagged as a rough guide only.
EVAL_PROFILE=test
# EVAL_SEED=42
# --- Concurrency (evaluation phase only; the speed tests always run one request at a time) ---
# How many questions are in flight at once per dataset. 1 = sequential (same behaviour and comparable s/q as earlier
# versions). The SERVER must serve requests in parallel for this to help: llama-server needs `--parallel N`
# (N >= this value; note the model context is divided between the slots), and llama-swap must route concurrent
# requests to the same model. s/q stays the mean latency of ONE question, so the Agent score is not inflated.
EVAL_CONCURRENCY=1
# aiohttp = native asyncio client | threads = requests on a thread pool | auto = aiohttp if installed
# EVAL_HTTP_BACKEND=auto
# How many generated programs may be executed at once (0 = auto: up to 4, never more than CPU cores)
# EVAL_SANDBOX_WORKERS=0
# EVAL_TEMPERATURE=0         # 0 = greedy = reproducible, but REASONING models can fall into endless repetition loops
#                            # at 0 (see EVAL_LOOP_ABORT). If you see many "Fail: Degradation" lines, use the sampling
#                            # settings the model's authors recommend (often 0.6-1.0) and keep EVAL_SEED for the rows.
# EVAL_MAX_TOKENS_QA / _CODE: leave unset (default) for DYNAMIC limits: each question gets max_tokens = the model's
# context size minus the prompt size (falls back to 4096 if the context size can't be read). A number here is used
# as an upper cap instead.
# EVAL_MAX_TOKENS_QA=
# EVAL_MAX_TOKENS_CODE=
# EVAL_RETRY_ON_LENGTH=true  # true = a reply that is cut off by the limit (or times out) is asked ONE more time with
#                            # thinking disabled ("No Thinking"). Those questions are flagged thinking_fallback_used
#                            # in eval_details_*.jsonl and counted in the eval_<dataset>_fallback CSV column.
#                            # false = no retry. A reply that still has no usable answer counts as wrong, tracked as N/A.
# EVAL_TIMEOUT=600           # seconds per request (a safety net: the settings below normally stop a bad reply long before)

# --- Progress lines in logs (Unraid User Scripts, cron, nohup) ---
# On a terminal the eval counter updates live. When output goes to a log/pipe it used to print only ONE line per
# dataset when it finished (hours of silence). Now a plain progress line is added every EVAL_LOG_INTERVAL seconds.
# EVAL_LOG_INTERVAL=300      # seconds between progress lines in a log; 0 = off (final line only)

# --- Streaming, loop abort, thinking cap (evaluation phase only; speed tests are never streamed) ---
# Replies are read as a stream, so a runaway reply is stopped within seconds instead of after EVAL_TIMEOUT, and
# whatever the model had written is kept (eval_details_*.jsonl -> "attempts" -> "tail"). A stopped reply is handled
# in this order: 1) its visible answer is already complete -> graded as it is (EVAL_SALVAGE);
# 2) otherwise ONE retry with thinking disabled (EVAL_RETRY_ON_LENGTH); 3) otherwise wrong, with the flag below.
# EVAL_STREAM=true           # false = old behaviour: no loop abort, no salvage, no live thinking budget
# EVAL_THINK_BUDGET=16384    # max tokens of THINKING per question; 0 = unlimited. "Fail: Think cap" when exceeded.
#                            # Raise it (e.g. 32768) if you want long reasoning to count; every cap hit is printed,
#                            # counted (eval_<dataset>_cap in the JSON) and visible in eval_details_*.jsonl.
#                            # The server is also told max_tokens <= budget + 4096, so it never runs on.
# EVAL_LOOP_ABORT=true       # stop a reply that repeats itself; flagged "Fail: Degradation" (CSV: eval_<dataset>_degr)
# EVAL_SALVAGE=true          # grade the visible answer of a stopped reply when it already contains one
# Extra JSON merged into every eval request, e.g. to switch off "thinking" on Qwen3-style models:
# EVAL_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Datasets are cached here (Hugging Face cache_dir). Pre-fetch with: python benchmark.py --download-datasets
# After that, runs read from local disk and never touch the internet. Relative paths are relative to benchmark.py.
# EVAL_CACHE_DIR=tests

# --- Running as a pure API client (no GPU on this machine / telemetry unavailable) ---
# RUN_SPEED_TESTS=false (or `python benchmark.py --evals-only`) skips the speed tests and ALL local telemetry
# (nvidia-smi, RAPL, RAM sampling, Home Assistant) and only runs the evaluations against the API.
RUN_SPEED_TESTS=true   # master togle (true/false) - default = true

# --- Code sandbox: generated code is UNTRUSTED ---
# auto = Docker if available (no network, read-only filesystem, memory/CPU/pid limits), else a plain subprocess
#        (timeout + rlimits, no network on Linux; NOT a security boundary against hostile code).
# docker | subprocess force one. Docker is strongly recommended for models you do not fully trust.
EVAL_CODE_SANDBOX=auto
# On startup (and in --check) the sandbox is self-tested: passing/failing programs, early sys.exit(0), an infinite
# loop, a forged result line and outbound network access. Docker runs as a non-root user with no network, a read-only
# filesystem, dropped capabilities and memory/CPU/pid limits, and leftover containers are cleaned up automatically.
# EVAL_CODE_TIMEOUT=10        # seconds per execution
# EVAL_CODE_MEM_MB=2048
# EVAL_CODE_DOCKER_IMAGE=python:3.11-slim
# EVAL_LCB_MAX_TESTS=20       # LiveCodeBench: tests per problem (0 = all)
# --- Hugging Face Token
#HF_TOKEN=hf_xxxxxxxxxxxxxxxx  #To allow for faster downloads. Not really required unless downloading LiveCodeBench
