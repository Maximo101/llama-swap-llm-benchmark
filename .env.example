# =====================================================================================================================
#  Local LLM Benchmark Suite settings
# =====================================================================================================================
#  Copy this file to .env (next to benchmark.py) and edit. Never commit .env: it holds tokens.
#  After an update, check your .env against this file:   python benchmark.py --check-env
#
#  The file has three parts:
#    PART 1  YOUR SETUP  check every line once for your machine.
#    PART 2  YOUR RUN    what to test and how big. Change these between runs.
#    PART 3  OPTIONAL    tuning. Everything there is commented out and already at its built-in default.
#
#  How a line reads:
#    KEY=value      # what it does   [default: x]    Active: this value is used. [default] is what you get without it.
#    # KEY=value    # what it does                   Commented: the value shown IS the built-in default.
#    # KEY=         # what it does                   Commented and empty: not set; the text says what happens then.
#
#  An empty active value is written KEY="" (KEY= followed by a comment would read the comment as the value).
#  true / false also accept 1/0, yes/no, on/off. Anything else (a typo like "tue") is read as false.
#  Lists are comma-separated. Token counts accept 8k / 64k / 128k. A setting in your shell environment wins over .env.
# =====================================================================================================================


# =====================================================================================================================
#  PART 1 - YOUR SETUP (check every line)
# =====================================================================================================================

# --- Server ---
LLAMA_SWAP_URL=http://localhost:8080   # llama-swap (or OpenAI-compatible) address, WITHOUT /v1   [default: http://localhost:8080]
# LLAMA_SWAP_API_KEY=                  # only if the endpoint needs a key (llama-swap and llama.cpp don't)
# HF_TOKEN=                            # Hugging Face token: avoids download rate limits (mostly matters for LiveCodeBench)

# --- This machine ---
RAM_PROCESS_PATTERN=llama-server       # regex: server process whose RAM is measured (--check lists matches)   [default: llama]
# GPU_INDEX=                           # benchmark one GPU (nvidia-smi index); empty = all GPUs together
BUDGET_PROFILE=server                  # deployment rules: server | main | <your own name> | none (Part 3)   [default: none]
BUDGET_PODIUM_PASS_ONLY=true           # a model that fails a rule stays in the table but off the podium   [default: true]
VRAM_SWEET_LOW=82                      # VRAM sweet spot (% of GPU): LOW..HIGH gets the full fit score   [default: 80]
VRAM_SWEET_HIGH=89.5                   # above HIGH the fit falls (to 50% at VRAM_SWEET_MAX, 0 at 100%)   [default: 90]
AGENT_CTX_MIN=65536                    # usable context below this gets no Agent score (small GPU: e.g. 32768; 0 = off)   [default: 65536]
#                                        usable = the loaded context, capped at the longest long-ctx length passed
AGENT_CTX_PASS_PCT=75                  # long-ctx retrieval % a length needs to count as usable (0 = use the loaded context)   [default: 75]
AGENT_CTX_CURVE="131072:1.0,78848:0.97,65536:0.95"   # mild Agent context factor: ctx:factor anchors, linear between   [default: 131072:1.0,78848:0.97,65536:0.95]
#                                        128k+ = 1.0, 96k ~0.98, 90k ~0.98, 77k 0.97, 64k 0.95; small GPU e.g. "65536:1.0,32768:0.9"
ESTIMATE_GPU_BW_GBS=auto               # GPU memory bandwidth (GB/s) for --estimate: auto = the detected GPU's, else 670   [default: auto]
#                                        e.g. 3060 360 | 4060 Ti 288 | 4070 504 | 4070 Ti Super 672 | 4090 1008 | 5070 672 | 5070 Ti 896 | 5090 1792

# --- Model files (llama-swap in Docker) ---
# The server sees e.g. /models/x.gguf. Run as root, the file is read through /proc/<pid>/root; otherwise map or search:
# GGUF_PATH_MAP=                       # container=host path pairs, e.g. /models=/mnt/AI-Models
# GGUF_SEARCH_DIRS=                    # folders to find model files by name, e.g. /mnt/AI-Models


# =====================================================================================================================
#  PART 2 - YOUR RUN (change per run; check the time first with: python benchmark.py --estimate)
# =====================================================================================================================

# --- What runs ---
RUN_SPEED_TESTS=true                   # speed + hardware telemetry (false = same as --evals-only)   [default: true]
RUN_EVAL_TESTS=true                    # accuracy evals after the speed tests (false = --speed-only)   [default: false]

# --- Which models (python benchmark.py --list-models shows what will run) ---
INCLUDE_MODELS=all                     # all, or comma-separated ids (case-insensitive, * ? wildcards)   [default: all]
EXCLUDE_MODELS=""                      # comma-separated model ids to skip   [default: empty]
# MODEL_FILTER=                        # regex applied as well, e.g. Qwen|gemma

# --- Datasets (only the ones set to true are downloaded and run) ---
EVAL_GPQA=false                        # GPQA Diamond: 198 q, 4 choices. Slow. Never publish its answers   [default: false]
EVAL_MMLU_PRO=true                     # MMLU-Pro: 12,032 q, up to 10 choices   [default: false]
EVAL_HUMANEVAL=true                    # HumanEval: 164 problems, pass@1 (runs code in the sandbox)   [default: false]
EVAL_MBPP=true                         # MBPP: 500 problems, pass@1 (runs code in the sandbox)   [default: false]
EVAL_LIVECODEBENCH=false               # LiveCodeBench: 1,055 problems, ~4 GB download. The slowest   [default: false]
EVAL_GSM8K=false                       # GSM8K: 1,319 grade-school word problems   [default: false]
EVAL_MATH=false                        # MATH-500: 500 competition problems   [default: false]
EVAL_TOOLCALL=true                     # tool calling: 32 built-in cases, no download (agent use)   [default: false]
EVAL_LONGCTX=true                      # long-context retrieval: codes hidden in one long document   [default: false]
LONGCTX_LENGTHS=65536,131072           # 32k 64k 128k; above a model's loaded context = skipped   [default: 65536,131072]

# --- Size of the run ---
# Rows per dataset (95% margin of error):  test 6 (+/-40%) | quick 11 (+/-30%) | basic 24 (+/-20%) | moderate 43 (+/-15%)
#   standard 96 (+/-10%) | thorough 196 (+/-7%) | deep 384 (+/-5%) | ultra 9604 (+/-1%) | full = every row
# funnel: every model answers quick, then confidence gates drop models clearly below the leaders and the rest go on
#   up to EVAL_FUNNEL_FINAL. About 40-50% less work with the same winner (README, "Funnel").
EVAL_PROFILE=funnel                    # funnel (recommended) or one of the profiles above; --estimate shows the time   [default: funnel]
EVAL_FUNNEL_FINAL=moderate             # where the funnel's finalists finish: basic ... full (bigger = smaller margin, longer)   [default: standard]
EVAL_CONCURRENCY=1                     # questions in flight per model; >1 needs slots (-np); see --batch-probe   [default: 1]

# --- Speed at the deployed context ---
PREFILL_CTX_TESTS=8192,32768,65536     # prefill speed per prompt length: 8k 16k 32k 64k 128k; empty = off   [default: empty]
AGENT_PROMPT_TOKENS=20000              # time to first token of an agent-sized prompt; 0 = off   [default: 0]
PREFILL_DEPTH=auto                     # prefill at depth: ~4k new tokens on top of a cached prompt; auto = per model, 0 = off   [default: auto]
#                                        auto = the largest of 8k/16k/32k/64k that fits with the 4k turn (64k ctx -> 32k, 90k+ -> 64k);
#                                        a number fixes it. What an agent waits for each turn (needs llama-server prompt-cache reuse)

# --- Answers: cache, sampling, thinking ---
EVAL_RESULT_CACHE=true                 # true = reuse earlier answers | refresh = ask all again | false = off   [default: true]
EVAL_SANITY_PCT=0                      # % of cached answers asked again and compared (0-100)   [default: 0]
EVAL_TEMPERATURE=server                # server = each model's llama-swap sampling (recommended) | a number overrides --temp   [default: server]
EVAL_SERVER_SAMPLING_MODELS=""         # regex: only these use their own sampling, e.g. gemma|Wicked   [default: empty]
EVAL_THINK_BUDGET=auto                 # max thinking tokens per question: auto = EVAL_THINK_BUDGET_PCT % of each model's context | a number | 0 = unlimited   [default: auto]

# --- Output files (folder: OUTPUT_DIR in Part 3; the newest dashboard is also benchmark_dashboard.html) ---
JSON=true                              # results JSON (needed by --reload, --compare, --estimate)   [default: true]
CSV=true                               # results CSV + the history CSV   [default: true]
LOG=true                               # log file with everything printed   [default: true]
WRITE_MARKDOWN=false                   # Markdown report   [default: true]


# =====================================================================================================================
#  PART 3 - OPTIONAL (all at the built-in default; uncomment a line to change it)
# =====================================================================================================================

# NOTIFY_URL=                          # POST a short JSON summary here when a run ends (e.g. a Home Assistant webhook); empty = off

# --- Strata fallback (a single OpenAI-compatible endpoint, used only when llama-swap is not reachable) ---
# STRATA_URL=                          # endpoint without /v1 (the old name STRATA_SWAP_URL is still read)
# STRATA_API_KEY=
# STRATA_MODEL=                        # model name sent; empty = first id from /v1/models, else "strata"
# STRATA_PARAMS_B=                     # total parameters (B), for ranking (Strata has no file name to parse)
# STRATA_ACTIVE_B=                     # active parameters (B), MoE only
# STRATA_QUANT=                        # empty = parsed from Strata's model id
# STRATA_CTX=                          # empty = read from Strata's API (see --probe-strata)

# --- GPU telemetry ---
# VRAM_LIMIT_GB=16                     # VRAM total (GB), used only if nvidia-smi doesn't report it
# GPU_POLL_MS=200                      # sampling interval in ms (minimum 100)
# GPU_BACKEND=auto                     # auto = NVML (nvidia-ml-py), else nvidia-smi | nvml | smi
# GPU_ENERGY_COUNTER=false             # true = NVML energy counter (exact, Volta+) | false = mean power x time (as old runs)
# MAX_GPU_TEMP=0                       # GPU temperature in C at which the run pauses by itself (e.g. 85); 0 = off. Read on THIS machine's hottest GPU, so run on the GPU host
# GPU_TEMP_RESUME_DELTA=10             # carries on by itself when the GPU is MAX_GPU_TEMP minus this (C) or cooler
# GPU_TEMP_MAX_RESTARTS=3              # one test line (a model's speed test, a dataset) stopped this often by the limit ends the run (resumable with --resume); 0 = never

# --- RAM and spill ---
# RAM_POLL_MS=500                      # sampling interval in ms (minimum 200)
# RAM_SPILL_THRESHOLD_GB=2             # spill limit, used only when launch flags can't be read (e.g. Strata)
# RAM_OVERHEAD_GB=                     # server RAM of a fully-GPU model; empty = measured in this run
# GOLDILOCKS_VRAM_ONLY=false           # true = models that spill into RAM are kept off the podium

# --- CPU power ---
# RAPL_PATH=/sys/class/powercap        # RAPL energy counters (Intel; AMD on Linux >= 5.8); usually needs root
# HA_URL=                              # fallback without RAPL: Home Assistant, e.g. http://homeassistant.local:8123
# HA_TOKEN=                            # long-lived Home Assistant token; keep it in .env only
# HA_CPU_POWER_ENTITY=                 # e.g. sensor.my_server_cpu_power (polled, so it lags short requests)
# HA_POLL_INTERVAL=1                   # seconds

# --- Speed test details ---
# RUNS_PER_PROMPT=3                    # runs per prompt; the median is reported
# TECH_PROMPT="Explain quantum computing in 3 sentences."
# LOGIC_PROMPT="Outline a 101 Biology textbook. Give 2 experiments and a 3-question quiz."
# MAX_TOKENS_TECH=300
# MAX_TOKENS_LOGIC=500
# TEMPERATURE=server                   # speed tests only: server = llama-swap's sampling | a number (evals: EVAL_TEMPERATURE)
# TIMEOUT_TECH=60                      # seconds
# TIMEOUT_LOGIC=300                    # seconds
# TIMEOUT_LOAD=300                     # seconds for a model to load
# RETRIES=2
# SERVER_WAIT_SECONDS=600              # llama-swap not answering mid-run: wait this long for it to come back, then ask the failed requests once more; 0 = off
# SETTLE_SECONDS=5                     # wait after unloading, then sample the idle baseline
# COOLDOWN_SECONDS=5                   # pause between models
# PREFILL_WORDS=1200                   # short prefill test (~1.5k tokens); 0 = off
# CACHE_TEST=true                      # cold vs warm prompt-cache test (needs PREFILL_WORDS > 0)

# --- Context and launch flags ---
# The benchmark reads -c, the KV type, -fa, -np, --kv-unified, mmproj and offload from the llama-server command and
# the GGUF header. It cannot change them: edit llama-swap's config for that.
# MIN_CTX=                             # minimum loaded context (e.g. 65536 or 64k); empty = the budget profile's MIN_CTX
# MIN_CTX_ACTION=flag                  # flag = run it, mark it, keep it off the podium | refuse = skip the model
# GGUF_INSPECT=true                    # read the GGUF header (size, bits per weight, architecture, KV cost per token)
# MAX_CTX_VRAM_PCT=85                  # "Max ctx" column: the context that fits with VRAM at this % of the GPU
# LONGCTX_KV_MIN=q8_0                  # long-ctx: lowest KV type accepted (f16 > q8_0 > q5_1 > q5_0 > q4_1 > q4_0)
# LONGCTX_KV_ACTION=flag               # below LONGCTX_KV_MIN: flag | skip
# LONGCTX_TRIALS=2                     # long-ctx questions per length (all about one shared document)
# LONGCTX_KEYS=4                       # codes asked for per question (maximum 12)
# LONGCTX_NO_THINK=true                # ask long-ctx with thinking off (a retrieval test, not a reasoning test)

# --- Budget profile rules ---
# Built-in:  server = MIN_CTX 65536, VRAM_RESERVE_GB 2.0, MAX_VRAM_PCT 100, KV_MIN q8_0, MAX_RETRY_PCT 25
#            main   = MIN_CTX 65536, VRAM_RESERVE_GB 1.5, MAX_VRAM_PCT 100, MAX_RETRY_PCT 25
# Change or add a rule: BUDGET_<PROFILE>_<RULE>=value (empty/off = not checked), e.g. BUDGET_SERVER_VRAM_RESERVE_GB=1.75
# Rules: MIN_CTX, VRAM_RESERVE_GB, MAX_VRAM_PCT, KV_MIN, MAX_SPILL_GB, MIN_TPS, MIN_PREFILL_TPS, MAX_AGENT_TTFT_S,
#        MIN_EVAL_PCT, MAX_RETRY_PCT, MIN_LONGCTX_PCT.  VRAM rule: model VRAM over idle + reserve <= GPU x MAX_VRAM_PCT
# BUDGET_<PROFILE>_<RULE>=             # any number of these

# --- Ranking ---
# GOLDILOCKS_MODE=linear               # linear = params x TPS | log = ln(params) x TPS
# GOLDILOCKS_MAX_VRAM_PCT=100          # models above this % of VRAM are kept off the podium
# VRAM_SWEET_MAX=94                    # VRAM % where the sweet-spot fit has fallen to 50%
# VRAM_UNDERUSE_FLOOR=0.85             # fit of a model that uses almost no VRAM (0-1)

# --- Agent score (0-100): quality first, speed second ---
# Quality = composite of evals / tool calling / long-ctx (over the lengths every ranked model ran) vs the best model:
# a tie within its noise (AGENT_ACC_TOL), then a steep fall; x (1 - penalty x retry share) x the context factor
# (AGENT_CTX_CURVE, Part 1). Speed (prompt processing 50%: prefill at depth + agent TTFT; s/q 30%; generation 20%)
# can remove at most AGENT_SPEED_WEIGHT of it. No Agent score below AGENT_CTX_MIN (usable context) or MIN_TOOLCALL_PCT.
# AGENT_SPEED_WEIGHT=0.3               # 0 = accuracy only, 1 = speed can erase the whole score
# AGENT_ACC_TOL=                       # points below the best still counted as a tie; empty = 1 standard error of the composite
# AGENT_ACC_SPAN=40                    # points under the tie zone at which the accuracy credit reaches 0
# AGENT_FALLBACK_PENALTY=10            # % of quality lost if EVERY question needed the No-Thinking retry
# AGENT_TOOL_WEIGHT=0.30               # share of the composite from tool calling (the evals get what tools + long-ctx leave)
# AGENT_LONGCTX_WEIGHT=0.25            # share of the composite from long-ctx retrieval
# MIN_TOOLCALL_PCT=70                  # tool calling below this % gets no Agent score (0 = off); near it = "borderline"
# AGENT_SEC_REF=60                     # s/q at which the s/q credit halves
# AGENT_TTFT_REF=15                    # agent-prompt TTFT (s) at which its credit halves (prefill at depth: 20000/this tok/s)
# AGENT_PREFILL_REF=4000               # prefill tok/s for full credit (used when neither agent prompt test is measured)
# AGENT_TPS_REF=200                    # generation tok/s for full credit
# EVAL_SQ_BASIS=auto                   # s/q it uses: auto (single-stream estimate when batching) | measured | single

# --- Dashboard view (display only: never changes a score; the page has toggles, remembered in your browser) ---
# COLOUR_STYLE=bands                   # bands = 6 flat tiers | smooth = a gradient between the tier colours
# COLOUR_MODE=absolute                 # absolute = the thresholds below | relative = tiers spread over this run's own range
# COLOUR_<METRIC>=                     # five thresholds, worst to best (6 tiers: red with a warning sign, pink, amber,
#                                        green, blue, purple). Metrics and defaults: GEN 30,40,50,80,100 tok/s;
#                                        PREFILL 500,1000,1500,2500,4000 tok/s; ACC 50,60,70,80,90 %; SCORE 50,60,70,80,90;
#                                        lower is better: TTFT_MS 2000,1000,500,250,100; AGENT_TTFT 40,20,13,8,5 s;
#                                        DEPTH_TTFT 8,4,2.7,1.6,1 s; SQ 120,90,60,30,15 s; RETRY 25,20,15,10,5 %;
#                                        POWER 300,250,200,150,100 W. E.g. a small GPU: COLOUR_GEN=10,15,20,30,40
# DASH_FAMILIES=                       # Family filter chips: "Name=pattern|pattern; Name2=pattern", * and ? wildcards,
#                                        case-insensitive, e.g. "Gemma 4=*gemma-4*|Air*|Wicked*; BigBang=*BigBang*"

# --- Settings page (python benchmark.py --ui) ---
# UI_PORT=41010                        # port of the settings page
# UI_HOST=                             # empty = this machine only (127.0.0.1); 0.0.0.0 or a LAN IP = open it from another PC (an address, not a URL)
#                                        (then a token is required; plain HTTP, so the token travels unencrypted)
# UI_TOKEN=                            # token for the page; generated and saved here on the first LAN start

# --- Electricity cost (adds $/1M tokens and $/1k queries columns) ---
# ELECTRICITY_RATE_PEAK=               # price per kWh, e.g. 0.60
# ELECTRICITY_RATE_OFFPEAK=            # set it too for a Peak / Off-peak toggle on the dashboard
# CURRENCY_SYMBOL=$

# --- Dashboard header: host hardware (auto-detected; set to override) ---
# HW_CPU=                              # e.g. Intel Core Ultra 5 245K
# HW_RAM=                              # e.g. 64 GB DDR5
# HW_GPU=                              # e.g. RTX 5070 Ti 16 GB

# --- Folders (relative paths are relative to benchmark.py, not the current directory) ---
# OUTPUT_DIR=results                   # results, logs and dashboards
# EVAL_CACHE_DIR=tests                 # dataset download cache (pre-fetch with --download-datasets)
# EVAL_RESULT_CACHE_DIR=               # answer cache; empty = <OUTPUT_DIR>/cache. Never publish it after GPQA

# --- Funnel and question sampling ---
# EVAL_FUNNEL_STAGES=                  # explicit stages, e.g. quick,moderate,standard; empty = quick, basic, ..., final
# EVAL_LEADERS=5                       # MINIMUM number of models kept at every gate (not a top-K cut)
# EVAL_FUNNEL_CONF=0.95                # one-sided confidence of each gate; higher = keeps more models, saves less
# EVAL_FUNNEL_MARGIN=3                 # points added to a model's upper bound at a gate (v2.3.3); higher = keeps more models
# EVAL_HARD_FAIL=stop                  # stop = a model that fails a hard Agent rule (context / tool calling / long-context
#                                        below AGENT_CTX_MIN / MIN_TOOLCALL_PCT) gets no further stages | continue = keep asking
# EVAL_SEED=42                         # picks the questions (the same for every model); also the server-sampling seed
# EVAL_SKIP_INELIGIBLE=auto            # auto = no evals for models already off the podium (MIN_CTX, budget rule when
#                                        BUDGET_PODIUM_PASS_ONLY=true, VRAM %) | true = also otherwise | false = evaluate all

# --- Result cache sanity check ---
# EVAL_SANITY_ADAPTIVE=true            # per model: a match halves the rate (20 -> 10 -> 5 -> 2 -> 0), a difference resets it

# --- Streaming, loops and thinking ---
# A stopped reply is 1) graded if its visible answer is complete (EVAL_SALVAGE), else 2) asked once more with thinking
# off (EVAL_RETRY_ON_LENGTH), else 3) wrong.
# EVAL_STREAM=true                     # false = no loop abort, no salvage, no budget forcing, no live thinking budget
# EVAL_LOOP_ABORT=true                 # stop a reply that repeats itself -> "Fail: Degradation"
# EVAL_SALVAGE=true                    # grade the visible answer of a stopped reply when it is already complete
# EVAL_RETRY_ON_LENGTH=true            # one No-Thinking retry for a reply cut off by the limit or a timeout
# EVAL_BUDGET_FORCING=false            # at the thinking cap: close the thinking and ask for the answer (s1 method)
# EVAL_THINK_BUDGET_PCT=25            # with EVAL_THINK_BUDGET=auto: the share of the model's context for thinking (5-90; 25 gives 32,768 at 128k, 16,384 at 64k)
# EVAL_THINK_BUDGET_MIN=4096          # with auto: never fewer thinking tokens than this, however small the context (floor; min 256)
# EVAL_THINK_BUDGET_MAX_PCT=60        # with auto: never more than this share of the context (ceiling, 10-90; the rest is left for the answer)
# EVAL_THINK_BUDGET_<DATASET>=         # per dataset, e.g. EVAL_THINK_BUDGET_GSM8K=2048 (opt-in; changes what is measured)
# EVAL_MAX_TOKENS_QA=                  # empty = dynamic (context minus prompt); a number = an upper cap
# EVAL_MAX_TOKENS_CODE=                # same, for the code datasets
# EVAL_TIMEOUT=600                     # seconds per request (a safety net)
# EVAL_EXTRA_BODY=                     # JSON added to every eval request, e.g. {"chat_template_kwargs": {"enable_thinking": false}}
# EVAL_TOOLCALL_STRICT=true            # only native tool_calls count; a call written as text fails (usually: no --jinja)
# EVAL_LOG_INTERVAL=300                # seconds between progress lines when output goes to a log; 0 = final line only

# --- Code sandbox (code written by models is UNTRUSTED) ---
# EVAL_CODE_SANDBOX=auto               # auto / docker = Docker (no network, read-only, non-root); stops without Docker
#                                        subprocess = runs as your user with only limits: NOT a security boundary
# EVAL_CODE_TIMEOUT=10                 # seconds per program
# EVAL_CODE_MEM_MB=2048
# EVAL_CODE_DOCKER_IMAGE=python:3.11-slim
# EVAL_SANDBOX_WORKERS=0               # programs run at once; 0 = auto (up to 4, never more than CPU cores)
# EVAL_HTTP_BACKEND=auto               # auto | aiohttp | threads

# --- LiveCodeBench and dataset pinning ---
# EVAL_LCB_MAX_TESTS=20                # LiveCodeBench tests per problem; 0 = all (official scoring uses all)
# EVAL_LCB_SINCE=                      # only problems released on/after, e.g. 2025-01-01 (not comparable without it)
# Pin a Hugging Face dataset to a commit hash, so a changed copy cannot silently change scores:
# EVAL_GPQA_REVISION=
# EVAL_MMLU_PRO_REVISION=
# EVAL_HUMANEVAL_REVISION=
# EVAL_MBPP_REVISION=
# EVAL_LIVECODEBENCH_REVISION=
# EVAL_GSM8K_REVISION=
# EVAL_MATH_REVISION=

# --- --batch-probe and --estimate ---
# BATCH_PROBE_LEVELS=1,2,4,8           # requests in flight to try
# BATCH_PROBE_QUESTIONS=32             # questions per level (spread over the enabled datasets)
