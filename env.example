# Copy to .env and edit. Never commit .env.
# This tool is meant to run ON the machine that has the GPU (it reads nvidia-smi and the CPU directly).

# --- llama-swap (or any OpenAI-compatible /v1 endpoint) ---
LLAMA_SWAP_URL=http://localhost:8080     # This is where you put your server address EXCLUDING the /v1 endpoint
# LLAMA_SWAP_API_KEY=                    # api key if required, eg unsloth interface requires this, lama-swap and llama.cpp do not

# --- Optional fallback: a single Strata endpoint, used only if llama-swap is not reachable ---
# STRATA_URL=http://localhost:8080
# STRATA_API_KEY=
# STRATA_MODEL=qwen3.8-Next-Flash # model name sent in requests (default: first id from /v1/models, else "strata")
# STRATA_PARAMS_B=125             # facts about the model, for ranking/radar (it has no filename to parse)
# STRATA_ACTIVE_B=3.8             # active params if MoE, else leave unset
# STRATA_QUANT=IQ3_S              # optional: otherwise parsed from Strata's own model id
# STRATA_CTX=32768                # optional: otherwise read from Strata's API (see --probe-strata)

# --- GPU ---
# Fallback VRAM total (GB) if nvidia-smi doesn't report it
VRAM_LIMIT_GB=16
# Benchmark one GPU only (nvidia-smi index). Empty = aggregate all GPUs.
# GPU_INDEX=0
GPU_POLL_MS=200

# --- System RAM / spill detection ---
# Name (regex) of the inference-server executable, to measure how much RAM it holds. Run --check to see matches.
RAM_PROCESS_PATTERN=llama-server
RAM_POLL_MS=500
RAM_SPILL_THRESHOLD_GB=2     # only used when launch flags can't be read (e.g. Strata)
# RAM_OVERHEAD_GB=2          # typical server RAM of a fully-GPU model; default: measured from this run
# GOLDILOCKS_VRAM_ONLY=false # true = exclude models that spill into RAM from the podium

# --- CPU power ---
# Read from RAPL energy counters (Intel, and AMD on Linux >= 5.8). Usually needs root.
RAPL_PATH=/sys/class/powercap
# Fallback if RAPL isn't readable: a Home Assistant power sensor (polled, so it lags short requests)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=            # long-lived token; keep it in .env only
# HA_CPU_POWER_ENTITY=sensor.my_server_cpu_power
HA_POLL_INTERVAL=1

# --- Benchmark behaviour ---
RUNS_PER_PROMPT=3            # median is reported
TIMEOUT_TECH=60
TIMEOUT_LOGIC=300
TIMEOUT_LOAD=300
MAX_TOKENS_TECH=300
MAX_TOKENS_LOGIC=500
TEMPERATURE=0.2
RETRIES=2
SETTLE_SECONDS=5             # wait after unloading, then sample idle baseline
COOLDOWN_SECONDS=5           # pause between models
PREFILL_WORDS=1200           # long-prompt prefill test (~1.5k tokens). 0 disables
CACHE_TEST=true              # cold vs warm prompt-cache test (needs PREFILL_WORDS > 0)
# MODEL_FILTER=Qwen|gemma    # regex; only benchmark matching model ids
# TECH_PROMPT=Explain quantum computing in 3 sentences.
# LOGIC_PROMPT=Outline a 101 Physics Handbook. Create a 3-question quiz.

# --- Ranking ---
GOLDILOCKS_MODE=linear       # linear = params_B x TPS, log = ln(params_B) x TPS
GOLDILOCKS_MAX_VRAM_PCT=100  # models above this % of VRAM are excluded from the podium
# AGENT_SEC_REF=60           # Agent score: quality = eval avg % / (1 + avg seconds-per-question / AGENT_SEC_REF).
#                            # A model averaging this many s/q keeps 50% of its eval score (4x this = 20%). Higher = time matters less.

# --- Electricity cost (optional; adds $/1M tokens and $/1k queries columns) ---
# Price per kWh in your currency. Set OFFPEAK too to get a Peak / Off-peak toggle on the dashboard.
# ELECTRICITY_RATE_PEAK=0.60
# ELECTRICITY_RATE_OFFPEAK=0.35
CURRENCY_SYMBOL=$

# --- Dashboard header: host hardware (auto-detected; set any of these to override) ---
# HW_CPU=Intel Core
# HW_RAM=32 GB DDR4
# HW_GPU=RTX 5060 Ti 16 GB

# --- Output ---
# Leave unset to write to a "results" folder next to benchmark.py (regardless of where you run it from).
# A relative value is also resolved against the script's folder, not the current directory.
# OUTPUT_DIR=results
WRITE_MARKDOWN=false    #true if you want one created, false if you dont
LOG=true                # true = also save everything printed to results/benchmark_<date>_<time>.log (with start/end/time taken)
CSV=true                # true = write results/benchmark_<date>_<time>.csv and append to the history CSV; false = no CSV files
# The newest dashboard is always written next to benchmark.py as benchmark_dashboard.html; a timestamped copy goes in the results folder.

# ============================================================================
# Model selection
# ============================================================================
# `python benchmark.py --list-models` prints what the server offers ([x] = will run) and exits.
# INCLUDE_MODELS: "all" or a comma-separated list of exact model ids (case-insensitive; * and ? wildcards work).
# EXCLUDE_MODELS: comma-separated ids to skip. MODEL_FILTER (regex, above) still works and is applied as well.
INCLUDE_MODELS=all
# INCLUDE_MODELS=model-a,model-b
EXCLUDE_MODELS=

# ============================================================================
# Evaluations (accuracy / pass-rate tests, run AFTER the speed tests)
# ============================================================================
RUN_EVAL_TESTS=true         # master toggle  (true/false)
# Only datasets set to true are loaded and run:
EVAL_GPQA=false              # GPQA Diamond (198 q, 4-choice)              -> accuracy  (skip for routine runs)
EVAL_MMLU_PRO=true           # MMLU-Pro (12,032 q, up to 10 choices)       -> accuracy
EVAL_HUMANEVAL=true          # HumanEval (164 problems)                    -> pass@1
EVAL_MBPP=true               # MBPP (500 test problems)                    -> pass@1
EVAL_LIVECODEBENCH=false     # LiveCodeBench (1,055 problems, ~4 GB download) -> pass@1  (skip for most runs)
# EVAL_PROFILE = rows per dataset (approx. margin of error, 95% confidence):
#   test = 6 (+/-40%) | quick = 11 (+/-30%) | basic = 24 (+/-20%) | fast = 43 (+/-15%) | standard = 96 (+/-10%)
#   thorough = 196 (+/-7%) | deep = 384 (+/-5%) | ultra = 9604 (+/-1%) | full = every row
# Rows are sampled with EVAL_SEED, so every model
# gets the same questions. (Datasets smaller than the profile are used in full.)
EVAL_PROFILE=test
# EVAL_SEED=42
# EVAL_TEMPERATURE=0
# EVAL_MAX_TOKENS_QA / _CODE: leave unset (default) for DYNAMIC limits: each question gets max_tokens = the model's
# context size minus the prompt size (falls back to 4096 if the context size can't be read). A number here is used
# as an upper cap instead.
# EVAL_MAX_TOKENS_QA=
# EVAL_MAX_TOKENS_CODE=
# EVAL_RETRY_ON_LENGTH=true  # true = a reply that is cut off by the limit (or times out) is asked ONE more time with
#                            # thinking disabled ("No Thinking"). Those questions are flagged thinking_fallback_used
#                            # in eval_details_*.jsonl and counted in the eval_<dataset>_fallback CSV column.
#                            # false = no retry. A reply that still has no usable answer counts as wrong, tracked as N/A.
# EVAL_TIMEOUT=600           # seconds per request
# Extra JSON merged into every eval request, e.g. to switch off "thinking" on Qwen3-style models:
# EVAL_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Datasets are cached here (Hugging Face cache_dir). Pre-fetch with: python benchmark.py --download-datasets
# After that, runs read from local disk and never touch the internet. Relative paths are relative to benchmark.py.
# EVAL_CACHE_DIR=tests

# --- Running as a pure API client (no GPU on this machine / telemetry unavailable) ---
# RUN_SPEED_TESTS=false (or `python benchmark.py --evals-only`) skips the speed tests and ALL local telemetry
# (nvidia-smi, RAPL, RAM sampling, Home Assistant) and only runs the evaluations against the API.
RUN_SPEED_TESTS=true   # master togle (true/false) - default = true

# --- Code sandbox: generated code is UNTRUSTED ---
# auto = Docker if available (no network, read-only filesystem, memory/CPU/pid limits), else a plain subprocess
#        (timeout + rlimits, no network on Linux; NOT a security boundary against hostile code).
# docker | subprocess force one. Docker is strongly recommended for models you do not fully trust.
EVAL_CODE_SANDBOX=auto
# EVAL_CODE_TIMEOUT=10        # seconds per execution
# EVAL_CODE_MEM_MB=2048
# EVAL_CODE_DOCKER_IMAGE=python:3.11-slim
# EVAL_LCB_MAX_TESTS=20       # LiveCodeBench: tests per problem (0 = all)

#HF_TOKEN=hf_xxxxxxxxxxxxxxxx  #hugging face token, to allow for faster downloads. Not really required unless downloading LiveCodeBench
